# =============================================================================
# AniManga Hub - Environment Variables
# =============================================================================
# Copy values as needed:
# - Backend local env file: backend/.env
# - Frontend local env file: frontend/.env.local
#
# NEVER commit real .env or .env.local files to git.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Phase 1C local development uses SQLite.
# This file path is relative to backend/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Future hosted PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/animanga_hub"


# -----------------------------------------------------------------------------
# NEXTAUTH - Future Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your_random_32_char_secret_here

# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# GOOGLE OAUTH - Future
# -----------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com
# 2. Create/select a project
# 3. APIs & Services > Credentials > Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# -----------------------------------------------------------------------------
# DISCORD OAUTH - Future
# -----------------------------------------------------------------------------
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application
# 3. OAuth2 > General > copy Client ID and Client Secret
# 4. Add redirect: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here


# -----------------------------------------------------------------------------
# STRIPE - Future Payments
# -----------------------------------------------------------------------------
# 1. Go to https://stripe.com
# 2. Developers > API Keys > copy Secret Key
# 3. Developers > Webhooks > Add endpoint > copy webhook signing secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_PREMIUM_PRICE_ID=price_your_premium_plan_price_id_here

# Public key is safe to expose in frontend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here


# -----------------------------------------------------------------------------
# API URLS
# -----------------------------------------------------------------------------
# Backend API URL
# Development: http://localhost:4000
# Production: https://your-backend-host.example
NEXT_PUBLIC_API_URL=http://localhost:4000

# External APIs. These public APIs do not need keys for current phases.
JIKAN_API_BASE=https://api.jikan.moe/v4
ANILIST_API_BASE=https://graphql.anilist.co
MANGADEX_API_BASE=https://api.mangadex.org


# -----------------------------------------------------------------------------
# EMAIL - Future Newsletter
# -----------------------------------------------------------------------------
# Resend is planned for a future newsletter phase.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@your-domain.com


# -----------------------------------------------------------------------------
# OPTIONAL SEARCH - Future
# -----------------------------------------------------------------------------
# Meilisearch may be used later for full-text search.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_api_key_here


# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
