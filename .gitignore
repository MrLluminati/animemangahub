# =============================================================================
# AniManga Hub — .gitignore
# =============================================================================

# Environment files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Backend build output
backend/dist/
backend/build/

# Prisma generated client (regenerated on install)
backend/node_modules/.prisma/

# Testing
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
.cache/
tmp/
temp/
