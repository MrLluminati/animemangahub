{
  "name": "animanga-hub-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.21.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "helmet": "8.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "20.17.6",
    "nodemon": "3.1.7",
    "prisma": "5.21.1",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
